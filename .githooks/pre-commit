#!/usr/bin/env bash
# Plain-bash pre-commit hook (PLAN §1.3).
#
# Runs the fast layer of the eight-stage acceptance chain so a commit can be
# blocked before it lands when a contributor breaks lint, types, or tests.
# Slow stages (coverage / diff-cover / mutmut) intentionally stay in CI via
# ``gates --all`` — see .github/workflows/gates.yml.
#
# Activation (one-time per clone):
#     git config core.hooksPath .githooks
#
# Notes:
# - ``set -euo pipefail`` propagates the first non-zero exit so the commit is
#   blocked on the first failing stage.
# - ``UV_CACHE_DIR`` defaults to the repo-local ``.cache/uv`` (gitignored) to
#   keep the sandbox-friendly behavior documented in tests/README §4.
# - Each stage is echoed with a banner so the failure attribution is obvious.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

: "${UV_CACHE_DIR:=$REPO_ROOT/.cache/uv}"
export UV_CACHE_DIR

banner() {
    printf '\n=== pre-commit: %s ===\n' "$1"
}

banner "ruff format --check ."
uv run ruff format --check .

banner "ruff check ."
uv run ruff check .

banner "basedpyright"
uv run basedpyright

banner "ty check ."
uv run ty check .

banner "pytest -q"
uv run pytest -q

printf '\npre-commit: all fast-layer gates green\n'
